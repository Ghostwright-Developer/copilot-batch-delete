{
  "manifest_version": 3,
  "name": "Clearcut Chats: Bulk Delete for AI Chats",
  "version": "1.2.0",
  "description": "Bulk delete chats in Microsoft Copilot, ChatGPT and Claude in a few clicks. Free, private, no refresh needed.",
  "homepage_url": "https://clearcutchats.ghostwrightweb.com",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://m365.cloud.microsoft/chat*",
    "https://microsoft365.com/chat*",
    "https://www.microsoft365.com/chat*",
    "https://www.office.com/chat*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Clearcut Chats",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://m365.cloud.microsoft/chat*",
        "https://microsoft365.com/chat*",
        "https://www.microsoft365.com/chat*",
        "https://www.office.com/chat*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ]
}